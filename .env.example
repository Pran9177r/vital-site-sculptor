# Environment Variables
# Create a .env.local file in this directory and fill in the values below.

# Contact Form Email Configuration
# Example: SendGrid, Resend, or standard SMTP credentials for info@teenharbor.com
# For now these are placeholders to prepare for future integration.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
CONTACT_EMAIL_FROM=noreply@teenharbor.com
CONTACT_EMAIL_TO=info@teenharbor.com
